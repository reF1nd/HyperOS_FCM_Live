<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <intent>
            <action android:name="com.google.android.c2dm.intent.RECEIVE" />
        </intent>
    </queries>
    <application
        android:name=".App"
        android:description="@string/xposed_description"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:ignore="AllowBackup,MissingApplicationIcon">
        <activity android:name=".SettingsActivity" android:exported="true"
            android:label="@string/app_name" android:theme="@style/Theme.HyperFCMLive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".Launcher" android:exported="true"
            android:label="@string/app_name" android:targetActivity=".SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
